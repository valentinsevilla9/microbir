# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY

# IA para crear flashcards desde los apuntes (basta con una de las dos).
# Si falla Gemini se usa Groq automáticamente.
GEMINI_API_KEY=
GROQ_API_KEY=

# Opcional: modelos a usar. Los proveedores retiran modelos a menudo; así se
# cambian sin tocar código. GEMINI_MODEL admite varios separados por comas
# (si uno está saturado se prueba el siguiente).
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-20b
